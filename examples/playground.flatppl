%%%
# Two-band photon photometry

Infer two spectral amplitudes from synthetic photon counts in two passbands.
Wavelengths and widths use metres, flux uses W/m^2/m, and area uses m^2.
Dust attenuation and photon-energy conversion enter the forward model.
%%%
flatppl_compat = "0.1"
astro = load_module("https://raw.githubusercontent.com/flatppl-community/flatppl-astro-templates/9869629c2e219fc6db420a053734e79956510d02/main.flatppl")
templates = load_module("https://raw.githubusercontent.com/flatppl-community/flatppl-stats-templates/314b0ced8ccd5ce320888cd643c3188c2510ba56/main.flatppl")
wavelengths = [4e-7, 5e-7, 6e-7]
widths = [1e-7, 1e-7, 1e-7]
spectra = rowstack([[1e-12, 2e-12], [2e-12, 1e-12], [1e-12, 3e-12]])
first_strength ~ Gamma(2, 2)
second_strength ~ Gamma(2, 2)
flux = templates.combine(spectra, [first_strength, second_strength])
attenuated = flux .* astro.dust_transmission([0.2, 0.1, 0.05])
first_mean = astro.photon_band_counts(wavelengths, attenuated, [0.8, 0.5, 0], widths, 100, 6.62607015e-34, 299792458)
second_mean = astro.photon_band_counts(wavelengths, attenuated, [0, 0.3, 0.7], widths, 100, 6.62607015e-34, 299792458)
observed ~ Poisson.([first_mean + 1, second_mean + 2])
model = lawof(record(first_strength = first_strength, second_strength = second_strength, observed = observed))
Pi_post = restrict(model, record(observed = [70, 90]))
